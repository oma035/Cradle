# ---------- Network ----------
# testnet while developing, mainnet for the real thing (real USDC!)
CRADLE_NETWORK=mainnet

# Soroban RPC used by the x402 client to build payments.
# Testnet default: https://soroban-testnet.stellar.org
# Mainnet: you MUST set one (e.g. from a Stellar RPC provider)
STELLAR_RPC_URL=

# ---------- x402 facilitator (OpenZeppelin Channels) ----------
# Get a key: mainnet https://channels.openzeppelin.com/gen
#            testnet https://channels.openzeppelin.com/testnet/gen
OZ_API_KEY=

# ---------- Cradle treasury (escrow) wallet ----------
# Receives x402 payments, pays experts, refunds mothers, sponsors new wallets.
# Generate with: npm run setup:treasury
TREASURY_SECRET=

# 32-byte hex key that encrypts users' wallet secrets in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used for the "Sign up as customer" link)
TELEGRAM_BOT_USERNAME=CradleCareBot

# ---------- Claude ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Web ----------
PORT=3000
# Public URL of this server (used in links sent to experts)
PUBLIC_URL=http://localhost:3000
ADMIN_PASSWORD=change-me

# ---------- Business rules ----------
REVIEW_PRICE_USD=0.20
# Percent of the price paid to the expert (rest stays with Cradle)
EXPERT_SHARE_PERCENT=100
# Refund the mother if no expert answers within this many minutes
REVIEW_TIMEOUT_MINUTES=120
